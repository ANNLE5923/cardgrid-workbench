{
  "name": "cardgrid-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build --configLoader native",
    "start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:independent": "node --experimental-strip-types --test tests/review/time-dial-3f-independent.test.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "description": "Local-first personal schedule and task workspace",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
