{
  "name": "cardgrid-workbench",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build --configLoader native",
    "start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node scripts/test.mjs",
    "test:independent": "node scripts/test.mjs --independent",
    "test:browser": "node scripts/browser-gate.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.62.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "description": "Local-first personal schedule and task workspace",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
